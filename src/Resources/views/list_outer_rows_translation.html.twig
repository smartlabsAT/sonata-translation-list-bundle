{#
    SonataTranslationListBundle — translation list mode template.

    Renders inside the <tbody> of Sonata Admin's base_list.html.twig.
    Works with any entity implementing TranslatableInterface (KnpDoctrineBehaviors).

    All translatable fields are rendered but hidden by default.
    The JS toggles field visibility client-side (no page reload).
#}

{% set config = translation_list_config(admin) %}
{% set translatable_fields = config.fields %}
{% set locales = config.locales %}
{% set default_locale = config.defaultLocale %}

{% if translatable_fields is empty %}
    <tr>
        <td colspan="100%" class="text-center text-muted" style="padding: 40px;">
            No translatable fields found for this entity.
        </td>
    </tr>
{% else %}
    {# Determine initially active fields from query parameter (comma-separated) #}
    {% set active_fields_param = app.request.query.get('translation_fields', translatable_fields|keys|first) %}
    {% set active_fields = active_fields_param|split(',') %}

    {# CSRF token for AJAX save requests #}
    {% set csrf_token = csrf_token('translation_list_save') %}

    {# Field selector row — buttons are toggles, JS handles show/hide #}
    <tr class="translation-list-header-row">
        <td colspan="100%">
            <div class="translation-field-selector">
                <span class="translation-field-label">Fields:</span>
                <div class="translation-field-buttons">
                    {% for fieldName, fieldLabel in translatable_fields %}
                        <button type="button"
                                class="btn btn-sm translation-field-toggle {{ fieldName in active_fields ? 'btn-primary' : 'btn-default' }}"
                                data-field="{{ fieldName }}">
                            {{ fieldLabel }}
                        </button>
                    {% endfor %}
                </div>
            </div>
        </td>
    </tr>

    {# Column headers — one group (DE/EN) per field #}
    <tr class="translation-list-columns-row">
        <th class="translation-col-identifier">
            {{ 'Name'|trans({}, admin.translationDomain) }}
        </th>
        {% for fieldName, fieldLabel in translatable_fields %}
            {% for locale in locales %}
                <th class="translation-col-locale translation-col-field"
                    data-translation-field="{{ fieldName }}"
                    {% if fieldName not in active_fields %}style="display:none;"{% endif %}>
                    <span class="translation-col-field-label">{{ fieldLabel }}</span>
                    <span class="translation-col-locale-label">{{ locale|upper }}</span>
                    {% if locale == default_locale %}
                        <i class="fas fa-home fa-xs text-muted" title="Default locale"></i>
                    {% endif %}
                </th>
            {% endfor %}
        {% endfor %}
    </tr>

    {# Data rows — one row per entity, all fields rendered #}
    {% for object in admin.datagrid.results %}
        <tr class="translation-list-data-row">
            {# Identifier column with link to edit form #}
            <td class="translation-cell-identifier">
                <a href="{{ admin.generateObjectUrl('edit', object) }}">
                    {{ admin.toString(object) }}
                </a>
            </td>

            {# All fields × all locales #}
            {% for fieldName, fieldLabel in translatable_fields %}
                {% for locale in locales %}
                    {% set is_default = (locale == default_locale) %}
                    {% set translation = object.translate(locale, false) %}
                    {% set getter = 'get' ~ (fieldName|slice(0, 1)|upper ~ fieldName|slice(1)) %}
                    {% set field_value = attribute(translation, getter) ?? '' %}

                    <td class="translation-cell translation-col-field translation-cell-editable"
                        data-translation-field="{{ fieldName }}"
                        {% if fieldName not in active_fields %}style="display:none;"{% endif %}>
                        <textarea
                            class="translation-textarea translation-editable {{ is_default ? 'translation-locale-default' : '' }}"
                            data-object-id="{{ admin.id(object) }}"
                            data-admin-code="{{ admin.code }}"
                            data-locale="{{ locale }}"
                            data-field="{{ fieldName }}"
                            data-original-value="{{ field_value }}"
                            rows="3"
                        >{{ field_value }}</textarea>
                    </td>
                {% endfor %}
            {% endfor %}
        </tr>
    {% endfor %}

    {# Hidden configuration for JavaScript #}
    <tr style="display:none;">
        <td>
            <span id="translation-list-save-url" data-url="{{ path('sonata_translation_list_save') }}"></span>
            <span id="translation-list-csrf-token" data-token="{{ csrf_token }}"></span>
            <span id="translation-list-active-fields" data-fields="{{ active_fields|join(',') }}"></span>
        </td>
    </tr>
{% endif %}
